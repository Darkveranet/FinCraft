# tools/api-automation/.env.fineract.example
#
# Optional overrides for the disposable docker-compose.fineract.yml stack.
# Copy to .env.fineract (git-ignored) only if you need non-defaults; the
# compose file already ships sane throwaway defaults.

# Pin a specific Fineract build (default: apache/fineract:latest)
FINERACT_IMAGE=apache/fineract:latest

# Postgres image for the disposable DB (default: postgres:16-alpine)
POSTGRES_IMAGE=postgres:16-alpine

# Throwaway credentials — these live and die with the container.
POSTGRES_PASSWORD=postgres
FINERACT_DB_PASSWORD=fineract

# First-tenant identifiers (Fineract's built-in default is fine here).
DEFAULT_TENANT_DB_NAME=fineract_default
DEFAULT_TENANT_IDENTIFIER=default

# Readiness polling (cold first boot runs full Liquibase migration).
WAIT_TRIES=60
WAIT_INTERVAL=10
